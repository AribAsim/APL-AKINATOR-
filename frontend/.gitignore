# =========================
# Universal .gitignore
# =========================

# -------------------------
# OS generated files
# -------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
Icon?
._*

# -------------------------
# Logs
# -------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Environment variables
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Dependency directories
# -------------------------
node_modules/
vendor/

# -------------------------
# Build outputs
# -------------------------
dist/
build/
out/
target/
bin/
coverage/
.cache/
tmp/
temp/

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.pytest_cache/
.mypy_cache/
venv/
.venv/

# -------------------------
# Java
# -------------------------
*.class
*.jar
*.war
*.ear
.gradle/
.idea_modules/

# -------------------------
# Kotlin
# -------------------------
*.kotlin_module

# -------------------------
# Go
# -------------------------
*.test
vendor/

# -------------------------
# Rust
# -------------------------
target/
Cargo.lock

# -------------------------
# PHP / Composer
# -------------------------
composer.lock

# -------------------------
# Ruby
# -------------------------
.bundle/
vendor/bundle/

# -------------------------
# .NET
# -------------------------
bin/
obj/
*.user
*.suo

# -------------------------
# C / C++
# -------------------------
*.o
*.obj
*.exe
*.dll
*.a
*.lib
*.so
*.dylib

# -------------------------
# Swift / Xcode
# -------------------------
DerivedData/
*.xcworkspace
*.xcuserdata/

# -------------------------
# Android
# -------------------------
.gradle/
local.properties
*.apk
*.aab

# -------------------------
# iOS
# -------------------------
Pods/

# -------------------------
# Terraform
# -------------------------
.terraform/
*.tfstate
*.tfstate.*

# -------------------------
# Docker
# -------------------------
docker-compose.override.yml

# -------------------------
# Kubernetes
# -------------------------
*.secret.yaml

# -------------------------
# IDEs & Editors
# -------------------------
.vscode/
.idea/
*.swp
*.swo
*.iml

# -------------------------
# Testing
# -------------------------
coverage/
.nyc_output/

# -------------------------
# Package managers
# -------------------------
package-lock.json
yarn.lock
pnpm-lock.yaml

# -------------------------
# Misc
# -------------------------
*.tmp
*.bak
*.cache
*.pid
*.seed